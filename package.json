{
  "name": "dsh-vscode",
  "displayName": "DSH Workspace",
  "description": "DeepSeek Harness GitHub project binding for VS Code",
  "version": "0.3.1",
  "publisher": "gmij",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dshWorkspace.setup",
        "title": "DSH Workspace: Setup Project"
      },
      {
        "command": "dshWorkspace.status",
        "title": "DSH Workspace: Check Project"
      },
      {
        "command": "dshWorkspace.openDiscussion",
        "title": "DSH Workspace: Open Discussions"
      },
      {
        "command": "dshWorkspace.runAgent",
        "title": "DSH Workspace: Run Existing Agent Workflow"
      },
      {
        "command": "dshWorkspace.attachExecutionRepo",
        "title": "DSH Workspace: Attach Agent Execution Repository"
      },
      {
        "command": "dshWorkspace.checkExecutionRepo",
        "title": "DSH Workspace: View Agent Workflow"
      },
      {
        "command": "dshWorkspace.chat",
        "title": "DSH Workspace: Chat via Real ACP"
      },
      {
        "command": "dshWorkspace.manageProfiles",
        "title": "DSH Workspace: Manage AI Endpoints"
      },
      {
        "command": "dshWorkspace.selectProfile",
        "title": "DSH Workspace: Switch AI Model"
      },
      {
        "command": "dshWorkspace.saveProjectProfiles",
        "title": "DSH Workspace: Save AI Endpoints to Project"
      },
      {
        "command": "dshWorkspace.importProjectProfiles",
        "title": "DSH Workspace: Load AI Endpoints from Project"
      }
    ],
    "configuration": {
      "title": "DSH Workspace",
      "properties": {
        "dshWorkspace.dshCommand": {
          "type": "string",
          "default": "dsh",
          "description": "Path to installed DSH executable; configure local DSH credentials separately."
        },
        "dshWorkspace.allowPlaintextProjectKeys": {
          "type": "boolean",
          "default": false,
          "description": "在项目 .dsh/ai-profiles.json 中明文保存 API Key（危险）。需要显式开启并再次确认。默认关闭。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/project.js && node --check src/acp.js && node --check src/profiles.js && node --check src/project_profiles.js"
  },
  "license": "MIT"
}
